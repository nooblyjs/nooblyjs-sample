# Noobly Knowledge Hub — example environment. Copy to .env and fill in values.
# Never commit your real .env. Runtime-tunable values (upload limits, digest
# schedule, AI on/off) live in the settings service, not here.

# ── Core ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# Required in production. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Master secret for the encrypted settings file (falls back to SESSION_SECRET).
SETTINGS_SECRET=
# Comma-separated API keys for /services/*/api. Required in production; in
# development a temporary key is generated and logged when empty.
API_KEYS=
# Password for the default admin (admin@localhost). When empty, one is
# generated and written to .application/data/auth/INITIAL_ADMIN_PASSWORD.txt.
DEFAULT_ADMIN_PASSWORD=

# ── AI (optional) ───────────────────────────────────────────────────────────
# Enables AI summaries and tags (Phase 5). Without it the app runs without AI.
ANTHROPIC_API_KEY=
# Overrides the claude provider's default model.
AI_MODEL=

# ── Deployment ──────────────────────────────────────────────────────────────
# Set behind a TLS-terminating proxy so secure session cookies work.
TRUST_PROXY=
# Shared session store (otherwise an in-process store).
SESSION_REDIS_URL=
# Where uploaded documents are stored (default ./.application/files).
FILING_BASE_DIR=
# Content-Security-Policy: enforce (default) | report-only | off
CSP_MODE=enforce
# Allowed CORS origins (comma-separated); same-origin only when empty.
CORS_ORIGINS=
# Max JSON/urlencoded body size.
BODY_LIMIT=1mb
# HTTPS (see nooblyjs-core src/shared/utils/createServer.js for HTTPS_* options)
HTTPS_ENABLED=false
